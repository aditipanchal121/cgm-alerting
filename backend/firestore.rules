rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isMember(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid));
    }
    function memberRole(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid)).data.role;
    }
    function isOwner(patientId) {
      return isMember(patientId) && memberRole(patientId) == 'owner';
    }

    match /patients/{patientId} {
      // resource.data, not isMember()'s exists() check - Firestore can only
      // authorize a list query (patientsForUser's array-contains) when the
      // rule is provable from the query filter + the document's own fields.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(patientId);

      // Physiological facts (ISF, carb ratio) - shared family-wide, unlike
      // members/{uid}/thresholds below. Owner-writable only.
      match /thresholds/{doc} {
        allow read: if isMember(patientId);
        allow write: if isOwner(patientId);
      }

      // Written only by Cloud Functions via the Admin SDK.
      match /readings/{doc} {
        allow read: if isMember(patientId);
        allow write: if false;
      }

      match /treatments/{doc} {
        allow read: if isMember(patientId);
        allow write: if false;
      }

      // Experimental predictors' latest output - Android Predictions tab's
      // data source (see predictionAccuracy.ts).
      match /livePredictions/{doc} {
        allow read: if isMember(patientId);
        allow write: if false;
      }

      // Overwritten every poll cycle - Dashboard's single source of truth
      // for the latest reading (see index.ts's writeCurrentReading).
      match /liveReading/{doc} {
        allow read: if isMember(patientId);
        allow write: if false;
      }

      // Offline analysis only - not read by the app.
      match /predictionAccuracy/{doc} {
        allow read, write: if false;
      }

      // Rolling IOB/COB window used only by predict_multi_bolus (see index.ts).
      match /iobCobHistory/{doc} {
        allow read, write: if false;
      }

      // Directly-reported IOB (paired phone's NotificationListenerService).
      // Write scoped to whichever UID the owner set via setIobSource.
      match /externalIob/{doc} {
        allow read: if isMember(patientId);
        allow write: if isSignedIn() &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.iobSourceUid == request.auth.uid;
      }

      // Append-only log of every externalIob value, for training-data joins.
      match /externalIobHistory/{doc} {
        allow read: if isMember(patientId);
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.iobSourceUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /members/{uid} {
        allow read: if isMember(patientId);
        allow create: if isSignedIn() && (
          (uid == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid)
          || isOwner(patientId)
        );
        allow update: if isOwner(patientId) ||
          (isSignedIn() && request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thresholds']));
        allow delete: if isOwner(patientId);

        // Written only by Cloud Functions.
        match /alerts/{doc} {
          allow read: if isSignedIn() && request.auth.uid == uid;
          allow create, update, delete: if false;
        }
      }
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
