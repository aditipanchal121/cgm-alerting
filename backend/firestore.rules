rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isMember(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid));
    }
    function memberRole(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)/members/$(request.auth.uid)).data.role;
    }
    function isOwner(patientId) {
      return isMember(patientId) && memberRole(patientId) == 'owner';
    }

    match /patients/{patientId} {
      // Read uses resource.data directly (not isMember's exists() check) because
      // Firestore can only authorize a *list* query (patientsForUser's
      // array-contains query, not just single-document gets) when the rule is
      // provable from the query's own filter + the candidate document's own
      // fields - it won't trust a cross-document exists() lookup keyed by a
      // wildcard that varies per result, which is what isMember() does.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(patientId);

      // Alert thresholds: family can see them, only the owner can change them.
      match /thresholds/{doc} {
        allow read: if isMember(patientId);
        allow write: if isOwner(patientId);
      }

      // Glucose/IOB history: written only by Cloud Functions via the Admin SDK,
      // which bypasses these rules entirely - clients never write readings directly.
      match /readings/{doc} {
        allow read: if isMember(patientId);
        allow write: if false;
      }

      // Alert event log: written by Cloud Functions; members may only toggle
      // the acknowledged fields, never create/delete history entries.
      match /alerts/{doc} {
        allow read: if isMember(patientId);
        allow update: if isMember(patientId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acknowledged', 'acknowledgedAt', 'acknowledgedBy']);
        allow create, delete: if false;
      }

      // Family membership: the patient's creator bootstraps themselves as
      // owner; only the owner can add/remove/re-role members after that.
      match /members/{uid} {
        allow read: if isMember(patientId);
        allow create: if isSignedIn() && (
          (uid == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid)
          || isOwner(patientId)
        );
        allow update, delete: if isOwner(patientId);
      }
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
