<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen widget showing the latest reading, arrow, and IOB.
    updatePeriodMillis is only an infrequent safety net - the platform
    clamps it to a 30-minute floor regardless of what's configured here,
    which is too coarse for a 5-minute glucose poll cycle. The widget is
    actually kept current by GlucoseWidgetProvider.updateFromReading, called
    from NightWatchFcmService every time a "reading" push arrives.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_glucose"
    android:previewLayout="@layout/widget_glucose"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
